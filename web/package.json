{
  "name": "island-echoes-web",
  "private": true,
  "type": "module",
  "description": "Builds the 3D globe bundle served from web/vendor. The bundle is committed, so running the app needs no Node.",
  "scripts": {
    "test": "node --test src/*.test.mjs",
    "build": "esbuild src/globe.js --bundle --minify --format=iife --global-name=IE3D --target=es2020 --legal-comments=none --outfile=vendor/globe.bundle.js"
  },
  "dependencies": {
    "globe.gl": "2.46.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
