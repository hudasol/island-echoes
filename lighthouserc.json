{
  "ci": {
    "collect": {
      "startServerCommand": "python -m uvicorn app.main:app --port 8000",
      "startServerReadyPattern": "Uvicorn running",
      "url": [
        "http://localhost:8000/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "chromeFlags": "--no-sandbox --use-gl=swiftshader --enable-unsafe-swiftshader"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.6
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 3000
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 600
          }
        ],
        "resource-summary:script:size": [
          "warn",
          {
            "maxNumericValue": 2300000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
