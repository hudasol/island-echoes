 "info": {
  "description": "Read only access to the sourced island library, NASA POWER readings, GBIF records and the educator sheets. Version 1 of the API lives under /api/v1.",
  "title": "Island Echoes",
  "version": "1.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/v1/chat": {
   "post": {
    "operationId": "v1_chat_api_v1_chat_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ChatRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ChatResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "V1.Chat"
   }
  },
  "/api/v1/data-changes": {
   "get": {
    "description": "Values that changed when live NASA POWER or GBIF data replaced older data on this server.",
    "operationId": "v1_data_changes_api_v1_data_changes_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "V1.Data Changes"
   }
  },
  "/api/v1/evaluation": {
   "get": {
    "description": "Stored evaluation numbers: retrieval on the gold sets and the end to end baselines.",
    "operationId": "v1_evaluation_api_v1_evaluation_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "V1.Evaluation"
   }
  },
  "/api/v1/health": {
   "get": {
    "operationId": "v1_health_api_v1_health_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "V1.Health"
   }
  },
  "/api/v1/islands": {
   "get": {
    "operationId": "v1_list_islands_api_v1_islands_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/IslandSummary"
         },
         "title": "Response V1 List Islands Api V1 Islands Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "V1.List Islands"
   }
  },
  "/api/v1/islands/{slug}": {
   "get": {
    "operationId": "v1_island_detail_api_v1_islands__slug__get",
    "parameters": [
     {
      "in": "path",
      "name": "slug",
      "required": true,
      "schema": {
       "title": "Slug",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/IslandDetail"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "V1.Island Detail"
   }
  },
  "/api/v1/islands/{slug}/conservation": {
   "get": {
    "description": "The IUCN Red List category that GBIF holds for the creature. 404 when GBIF has none.",
    "operationId": "v1_conservation_api_v1_islands__slug__conservation_get",
    "parameters": [
     {
      "in": "path",
      "name": "slug",
      "required": true,
      "schema": {
       "title": "Slug",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "creature",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Creature"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ConservationOut"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "V1.Conservation"
   }
  },
  "/api/v1/islands/{slug}/educator": {
