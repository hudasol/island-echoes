# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# ---- Chat model (all optional; the library works without any of this) ----
# LLM_PROVIDER = off | extractive | ollama | llamacpp | huggingface | openai-compat | anthropic
#   extractive   no model: quotes the top sources (a baseline, free)
#   ollama       a local model, free:  ollama pull qwen2.5:3b-instruct   then   LLM_PROVIDER=ollama
#   huggingface  free-tier hosted models with a free token (HF_TOKEN below)
#   anthropic    paid API (ANTHROPIC_API_KEY below)
LLM_PROVIDER=
LLM_MODEL=
OLLAMA_URL=http://localhost:11434
HF_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-sonnet-5-5

# ---- Retrieval ----
# bm25 (default, no extra install) | dense | hybrid (pip install -r requirements-ml.txt)
RETRIEVAL_MODE=bm25
RETRIEVAL_K=12

# ---- Statistics ----
TELEMETRY=true
# Store the text of questions (off by default; only a hash and length are kept)
LOG_QUESTIONS=false

# NASA POWER, GBIF and NASA GIBS are public and need no key.
# How long cached POWER/GBIF responses stay fresh before a live refresh (days).
SOURCE_TTL_DAYS=30
