# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required for chat and for the LLM judge in the eval.
ANTHROPIC_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-sonnet-5-5

# NASA POWER, GBIF and NASA GIBS are public and need no key.
# How long cached POWER/GBIF responses stay fresh before a live refresh (days).
SOURCE_TTL_DAYS=30
